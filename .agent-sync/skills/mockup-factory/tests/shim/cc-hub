#!/usr/bin/env bash
# Deterministic cc-hub shim for Mockup Factory tests.
# Reads scripted responses from $MOCKUP_FACTORY_TEST_SCENARIO (a JSON file).
# Every invocation pops the next entry from `calls[]` and emits it.
#
# Scenario JSON shape:
#   {
#     "calls": [
#       { "exit": 0, "stdout": "<json string>", "stderr": "" },
#       { "exit": 127, "stdout": "", "stderr": "command not found" },
#       ...
#     ]
#   }
#
# State between calls is tracked by incrementing a counter file next to the scenario.

set -euo pipefail

SUB="${1:-}"

if [[ "$SUB" == "--help" ]]; then
  echo "cc-hub shim (test)"
  exit 0
fi

# telegram sub-command always succeeds silently (AC-015 non-blocking)
if [[ "$SUB" == "telegram" ]]; then
  exit 0
fi

if [[ "$SUB" != "codex" ]]; then
  echo "cc-hub shim: unsupported sub-command '$SUB'" >&2
  exit 2
fi

SCENARIO="${MOCKUP_FACTORY_TEST_SCENARIO:-}"
if [[ -z "$SCENARIO" || ! -f "$SCENARIO" ]]; then
  echo "cc-hub shim: MOCKUP_FACTORY_TEST_SCENARIO unset or file missing" >&2
  exit 3
fi

COUNTER="${SCENARIO}.counter"
[[ -f "$COUNTER" ]] || echo 0 > "$COUNTER"
IDX="$(cat "$COUNTER")"
echo $((IDX + 1)) > "$COUNTER"

# jq extracts call[IDX]; exits 4 if out-of-bounds
CALL_JSON="$(jq -e ".calls[$IDX]" "$SCENARIO" 2>/dev/null)" || {
  echo "cc-hub shim: no call[$IDX] in $SCENARIO (scenario exhausted)" >&2
  exit 4
}

EXIT_CODE="$(echo "$CALL_JSON" | jq -r '.exit // 0')"
STDOUT="$(echo "$CALL_JSON" | jq -r '.stdout // ""')"
STDERR="$(echo "$CALL_JSON" | jq -r '.stderr // ""')"

[[ -n "$STDOUT" ]] && printf '%s\n' "$STDOUT"
[[ -n "$STDERR" ]] && printf '%s\n' "$STDERR" >&2
exit "$EXIT_CODE"
